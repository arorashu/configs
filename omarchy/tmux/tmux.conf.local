# Personal tmux overrides, adapted from:
# https://github.com/arorashu/configs/blob/main/.tmux.conf

# Detach instead of switching to another session when the current one is destroyed.
set -g detach-on-destroy on

# Use backtick as the primary prefix. Keep C-Space as a fallback prefix.
unbind C-b
set -g prefix '`'
set -g prefix2 C-Space
bind '`' send-prefix

# Split panes in the current directory with prefix + \ or prefix + -.
unbind '%'
unbind '"'
bind '\' split-window -h -c "#{pane_current_path}"
bind '-' split-window -v -c "#{pane_current_path}"

# Leave Alt+Left and Alt+Right available to terminal applications.
unbind -n M-Left
unbind -n M-Right

# Preserve modified arrow-key sequences for terminal applications.
set-window-option -g xterm-keys on

# Yank without leaving scroll/copy mode or leaving the selection highlighted.
bind -T copy-mode-vi y send -X copy-selection-no-clear \; send -X clear-selection
